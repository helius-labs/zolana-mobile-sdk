<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        package="com.flutter_rust_bridge.mopro_flutter_bindings">
    <!-- The wallet reads the chain, the indexer and the proving keys over the
         network. Flutter's template grants this only to debug and profile
         builds, so without it a release app fails every key download. -->
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
