{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TheBenchProject",
      "Effect": "Allow",
      "Action": ["devicefarm:CreateUpload", "devicefarm:GetUpload", "devicefarm:ScheduleRun", "devicefarm:GetRun"],
      "Resource": [
        "arn:aws:devicefarm:us-west-2:<account>:project:<project id>",
        "arn:aws:devicefarm:us-west-2:<account>:devicepool:<project id>/*",
        "arn:aws:devicefarm:us-west-2:<account>:upload:<project id>/*",
        "arn:aws:devicefarm:us-west-2:<account>:run:<project id>/*",
        "arn:aws:devicefarm:us-west-2::device:*"
      ]
    },
    {
      "Sid": "ListsTakeNoResource",
      "Effect": "Allow",
      "Action": ["devicefarm:ListArtifacts", "devicefarm:ListJobs"],
      "Resource": "*"
    }
  ]
}
